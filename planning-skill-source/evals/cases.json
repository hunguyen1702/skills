{
  "schema_version": 1,
  "cases": [
    {
      "id": "broad-multi-outcome-routes-a",
      "facts": {"outcomes": 3, "subsystems": 2, "major_decision_open": false, "one_session": false},
      "expected": {"route": "A", "artifacts": ["epic", "task-board"]}
    },
    {
      "id": "bounded-one-session-routes-b",
      "facts": {"outcomes": 1, "subsystems": 1, "major_decision_open": false, "one_session": true},
      "expected": {"route": "B", "artifacts": ["story", "implementation-task"]}
    },
    {
      "id": "broad-reroutes-to-b",
      "initial_facts": {"outcomes": 2, "subsystems": 1, "major_decision_open": false, "one_session": false},
      "clarified_facts": {"outcomes": 1, "subsystems": 1, "major_decision_open": false, "one_session": true},
      "expected": {"routes": ["A", "B"], "reconfirmation": true}
    },
    {
      "id": "bounded-reroutes-to-a",
      "initial_facts": {"outcomes": 1, "subsystems": 1, "major_decision_open": false, "one_session": true},
      "clarified_facts": {"outcomes": 2, "subsystems": 2, "major_decision_open": false, "one_session": false},
      "expected": {"routes": ["B", "A"], "reconfirmation": true}
    },
    {
      "id": "ambiguity-gets-focused-recommendation",
      "prompt": "Plan an export feature without choosing a format.",
      "expected": {"focused_question": true, "recommended_default": true}
    },
    {
      "id": "both-routes-require-confirmation",
      "expected": {"routes": ["A", "B"], "write_before_confirmation": false}
    },
    {
      "id": "route-a-exact-output",
      "expected": {"artifacts": ["epic", "task-board"], "detailed_future_plans": false}
    },
    {
      "id": "route-a-board-contract",
      "expected": {
        "columns": ["ID", "Planning unit", "Outcome", "Planning", "Document", "Notes"],
        "planning_values": ["needed", "planned"]
      }
    },
    {
      "id": "route-b-paired-output",
      "expected": {"artifacts": ["story", "implementation-task"], "mutual_links": true}
    },
    {
      "id": "unique-temporary-workspaces",
      "expected": {"different_paths": true, "parent": "/tmp"}
    },
    {
      "id": "delivery-reports-paths",
      "expected": {"all_absolute_paths": true, "highlight_route_a_board": true}
    },
    {
      "id": "default-does-not-mutate-input-repository",
      "expected": {"git_status_unchanged": true, "git_diff_unchanged": true}
    },
    {
      "id": "explicit-repository-output",
      "expected": {"requested_destination": true, "local_instructions_read": true}
    },
    {
      "id": "review-fallback",
      "expected": {"structured_self_review": true, "limitation_disclosed": true}
    },
    {
      "id": "required-independent-review",
      "expected": {"fresh_sub_agent": true, "no_speed_bypass": true}
    },
    {
      "id": "unclear-review-authorization",
      "expected": {"ask_user": true, "infer_permission": false, "deliver_before_answer": false}
    },
    {
      "id": "static-leakage-scan",
      "expected": {"forbidden_terms_rejected": true}
    },
    {
      "id": "runtime-parity",
      "expected": {"same_route": true, "same_document_structure": true}
    }
  ]
}
